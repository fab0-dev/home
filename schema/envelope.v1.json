{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.fab0.dev/envelope.v1.json",
  "oneOf": [
    {
      "$ref": "#/$defs/StepEnvelope"
    },
    {
      "$ref": "#/$defs/ActEnvelope"
    },
    {
      "$ref": "#/$defs/TestEnvelope"
    }
  ],
  "title": "fab0 envelope",
  "description": "A fab0 step, act or test envelope, as get_envelope answers it",
  "$defs": {
    "StepEnvelope": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "step"
        },
        "run": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            "pipeline": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "home": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+$"
            },
            "root": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9][0-9]*$"
            }
          },
          "required": [
            "id",
            "pipeline",
            "version",
            "home",
            "root"
          ],
          "additionalProperties": false
        },
        "item": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9][0-9]*$"
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "parent": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9][0-9]*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "its parent in the run; null for the root"
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "key",
            "type",
            "parent",
            "generation"
          ],
          "additionalProperties": false
        },
        "instance": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^.+\\.[a-z0-9]+(?:-[a-z0-9]+)*:([A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9][0-9]*):([1-9][0-9]*)\\.([1-9][0-9]*)(?:\\.v([0-9]+)\\.([1-9][0-9]*))?$"
            },
            "step": {
              "type": "string",
              "pattern": "^.+\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "round": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "launch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "step",
            "round",
            "attempt",
            "revision",
            "launch"
          ],
          "additionalProperties": false
        },
        "step": {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "enum": [
                "agent.routine",
                "agent.record"
              ]
            },
            "skill": {
              "type": "string",
              "minLength": 1,
              "description": "the skill to invoke, from the work repository's .claude/skills/"
            },
            "model": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "small",
                    "medium",
                    "large"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "repo": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+$",
              "description": "the work repository"
            },
            "makes": {
              "type": "string",
              "enum": [
                "pr",
                "issues",
                "none"
              ]
            },
            "kind": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "code",
                    "spec",
                    "plan",
                    "markdown"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "for makes: pr"
            }
          },
          "required": [
            "do",
            "skill",
            "model",
            "repo",
            "makes",
            "kind"
          ],
          "additionalProperties": false
        },
        "inputs": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9][0-9]*$"
              },
              "description": "the item and its ancestors up to the root, nearest first"
            },
            "prs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9][0-9]*$"
                  },
                  "step": {
                    "type": "string",
                    "pattern": "^.+\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "item": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9][0-9]*$"
                  },
                  "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                },
                "required": [
                  "key",
                  "step",
                  "item",
                  "sha"
                ],
                "additionalProperties": false
              },
              "description": "the merged PRs of the item's and its ancestors' done instances, at the approved SHA"
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "instance": {
                    "type": "string",
                    "pattern": "^.+\\.[a-z0-9]+(?:-[a-z0-9]+)*:([A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9][0-9]*):([1-9][0-9]*)\\.([1-9][0-9]*)(?:\\.v([0-9]+)\\.([1-9][0-9]*))?$"
                  },
                  "outputs": {}
                },
                "required": [
                  "instance",
                  "outputs"
                ],
                "additionalProperties": false
              },
              "description": "the kept outputs of the same instances"
            }
          },
          "required": [
            "items",
            "prs",
            "outputs"
          ],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "schema": {
              "anyOf": [
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                {
                  "type": "null"
                }
              ],
              "description": "the step's outputs.schema (E.9)"
            },
            "required": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "pr",
                  "issues",
                  "verdict"
                ]
              },
              "description": "the keys catalogue section 6 adds"
            }
          },
          "required": [
            "schema",
            "required"
          ],
          "additionalProperties": false
        },
        "markers": {
          "type": "object",
          "properties": {
            "branch": {
              "type": "string",
              "minLength": 1,
              "description": "fab0/<run_id>/<repo>-<number>/<step> (G.1)"
            },
            "body": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3,
              "description": "the three last lines of the PR body (G.2)"
            },
            "comment": {
              "type": "string",
              "minLength": 1,
              "description": "the agent marker (G.5)"
            }
          },
          "required": [
            "branch",
            "body",
            "comment"
          ],
          "additionalProperties": false
        },
        "spawn": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "left": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "type",
                "left"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "the budget left (L.11)"
        },
        "deadline": {
          "type": "string",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "the session clock (H.2)"
        },
        "skillVersion": {
          "type": "string",
          "minLength": 1,
          "description": "the worker skill version this envelope was written for"
        },
        "revision": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "feedback": {
                  "type": "string"
                },
                "pr": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9][0-9]*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "feedback",
                "pr"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "on a revision (L.8): the requests to address, and the bound PR to continue"
        },
        "review": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "instance": {
                  "type": "string",
                  "pattern": "^.+\\.[a-z0-9]+(?:-[a-z0-9]+)*:([A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9][0-9]*):([1-9][0-9]*)\\.([1-9][0-9]*)(?:\\.v([0-9]+)\\.([1-9][0-9]*))?$"
                },
                "pr": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9][0-9]*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sha": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "instance",
                "pr",
                "sha"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "for a reviewer step: the reviewed instance and the head it judges (E.11)"
        },
        "api": {
          "type": "string",
          "minLength": 1,
          "description": "the Agent API's base URL"
        }
      },
      "required": [
        "v",
        "kind",
        "run",
        "item",
        "instance",
        "step",
        "inputs",
        "output",
        "markers",
        "spawn",
        "deadline",
        "skillVersion",
        "revision",
        "review",
        "api"
      ],
      "additionalProperties": false,
      "description": "what a session needs to do one step instance"
    },
    "ActEnvelope": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "act"
        },
        "run": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            "pipeline": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "pipeline",
            "version"
          ],
          "additionalProperties": false
        },
        "act": {
          "type": "object",
          "properties": {
            "instance": {
              "type": "string",
              "pattern": "^.+\\.[a-z0-9]+(?:-[a-z0-9]+)*:([A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9][0-9]*):([1-9][0-9]*)\\.([1-9][0-9]*)(?:\\.v([0-9]+)\\.([1-9][0-9]*))?$"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "repo": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+$"
            },
            "delivery": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "person": {
              "type": "string",
              "minLength": 1,
              "description": "who makes it (I.5): the session works as this person"
            },
            "changes": {
              "minItems": 1,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "merge"
                      },
                      "pr": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9][0-9]*$"
                      },
                      "sha": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}$"
                      }
                    },
                    "required": [
                      "kind",
                      "pr",
                      "sha"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "label"
                      },
                      "item": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9][0-9]*$"
                      },
                      "add": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "remove": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "expect": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "item",
                      "add",
                      "remove",
                      "expect"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "description": "in order: a merge first, then labels"
            },
            "until": {
              "type": "string",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "the act clock (H.2)"
            }
          },
          "required": [
            "instance",
            "revision",
            "repo",
            "delivery",
            "person",
            "changes",
            "until"
          ],
          "additionalProperties": false
        },
        "api": {
          "type": "string",
          "minLength": 1,
          "description": "the Agent API's base URL"
        }
      },
      "required": [
        "v",
        "kind",
        "run",
        "act",
        "api"
      ],
      "additionalProperties": false,
      "description": "what a session needs to make one act"
    },
    "TestEnvelope": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "test"
        },
        "registration": {
          "type": "object",
          "properties": {
            "repo": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+$"
            },
            "model": {
              "type": "string",
              "enum": [
                "small",
                "medium",
                "large"
              ]
            }
          },
          "required": [
            "repo",
            "model"
          ],
          "additionalProperties": false,
          "description": "the registration the test fire is for"
        },
        "api": {
          "type": "string",
          "minLength": 1,
          "description": "the Agent API's base URL"
        }
      },
      "required": [
        "v",
        "kind",
        "registration",
        "api"
      ],
      "additionalProperties": false,
      "description": "what a test fire's session reads, which verifies its registration (I.5)"
    }
  }
}
